# Camera sensor and mode, for every firmware that has the camera (DASH_CAMERA=1; see the root CMakeLists.txt).
# Merged on top of board/sdkconfig.board and sdkconfig.defaults.

# The sensor: OV02C10, one MIPI lane, RAW10 through the ISP. The vendor's demo runs 1920x1080; the preview uses
# 1288x728 instead because the panel's PPA scaler takes ~100 ms for a 1080p frame (measured: 7.5 fps) and cost grows with
# the input pixels. (1920x1080 stays an option: CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920X1080_30FPS_1_LANE and its DEFAULT_FMT.)
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288X728_30FPS=y
CONFIG_CAMERA_OV02C10_MIPI_DEFAULT_FMT_RAW10_1288X728_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# TLS buffers (MQTT) in PSRAM. The camera takes internal RAM when it starts; the dashboard already runs on ~90 KB of it
# after the network is up, and a TLS record read then failed ("esp-aes: Failed to allocate memory for start alignment
# buffer", MQTT dropped). The default keeps every mbedTLS allocation internal; this sends them to the 32 MB PSRAM.
# (esp-aes still uses a few small internal DMA buffers of its own.)
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# The ISP pipeline controller's task stack (the auto exposure / white balance loop) in PSRAM too. The frame buffers
# (USERPTR, camera.c) and the CSI driver's buffers are PSRAM already.
CONFIG_ISP_PIPELINE_CONTROLLER_TASK_STACK_USE_PSRAM=y

# Small allocations in PSRAM too. The default sends every allocation of 4 KB or less to internal RAM; LVGL (clib malloc),
# std::string and most objects are small, so they filled it. Only allocations under 512 bytes stay internal now.
# SPIRAM_MALLOC_RESERVE_INTERNAL (32 KB) still keeps a pool for internal-only requests.
# 512 -> 128 once a real feed was seen (192 items): each cached FeedItem is a ~420-byte std::map node, which at 512
# stayed internal (~80 KB for the whole feed, more than the ~60-86 KB free after Wi-Fi). Then 128 -> 64 in the memory pass
# below: LVGL objects, styles and labels are 50-130 bytes each and there are well over a thousand of them.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64

# ESP-Hosted SDIO receive without "streaming mode". Streaming reads whatever the C6 has queued in one transfer and
# allocates ONE internal DMA buffer that big (sdio_rx_get_buffer asserts when it cannot). With the camera firmware the
# largest free internal block is ~31 KB once Wi-Fi comes up (see the `heap:` log lines), and the first burst of traffic
# after the IP is assigned crashed it: "assert failed: sdio_rx_get_buffer sdio_drv.c:896 (*buf)". Per-packet receive
# only ever needs a ~1.6 KB buffer. Costs some peak Wi-Fi throughput, which this panel (MQTT, a small JSON feed) never uses.
# board/sdkconfig.board picks streaming for the other firmwares, which have the RAM for it.
# CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE is not set
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_NONE=y

# --- Memory pass (internal RAM was at 100 %) -------------------------------------------------------------------------
# Measured on the built ELF (riscv32-esp-elf-size and the link map): 161 KB of internal RAM is code placed in IRAM, of
# which LVGL alone is 61.6 KB, FreeRTOS 20.6 KB, esp_hw_support 19.9 KB, ringbuf 5.6 KB. Static data adds ~65 KB. Every KB
# of it is a KB less for the heap, which is where Wi-Fi/ESP-Hosted, USB, the camera and the UI fight for ~330 KB.
# Code and read-only data already run from PSRAM (SPIRAM_XIP_FROM_PSRAM), so moving more code out of IRAM costs a little
# speed on the first run of a function and nothing on a cached hot loop.

# LVGL's blend/draw hot paths in IRAM (-61 KB). They run from PSRAM through the 256 KB cache instead. If frame rate ever
# suffers (the PC screen streaming while the UI animates), this is the first thing to put back (=y).
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n

# FreeRTOS and ring buffer: everything that is not ISR-safe runs from flash/PSRAM instead of IRAM (~12-15 KB and ~5 KB).
# The ISR-safe variants (xQueueSendFromISR ...) stay in IRAM, which is all an interrupt handler may call.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# Sleep support in IRAM: this wall panel never sleeps.
CONFIG_PM_SLEEP_FUNC_IN_IRAM=n
CONFIG_PM_SLP_IRAM_OPT=n
