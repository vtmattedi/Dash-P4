# Build output -- never committed.
.pio
build

# Fetched by the IDF component manager. dependencies.lock IS committed (it pins versions).
/managed_components

# Generated by PlatformIO from sdkconfig.defaults + board/sdkconfig.board.
# sdkconfig.defaults is source and stays tracked.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults

# Secrets. include/creds.h carries Wi-Fi and MQTT credentials and the broker CA.
# Copy include/creds.example.h and fill it in.
/include/creds.h

# Generated by src/Version/script.py on every build.
/include/Version.h
/src/Version/.version_no_increment*

# Local agent notes (findings, decisions, plan, journal).
/.local

# Editor caches.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
